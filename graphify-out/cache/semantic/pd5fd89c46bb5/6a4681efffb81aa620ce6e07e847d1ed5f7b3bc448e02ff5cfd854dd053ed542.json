{"nodes": [{"id": "docs_decisions_0014_undo_is_snapshots_undo_snapshots", "label": "Undo/Redo as Whole-Document Snapshots", "file_type": "rationale", "source_file": "docs/decisions/0014-undo-is-snapshots.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inverse ops force every future feature to implement a correct inverse forever; a missing one silently corrupts. Doc is a plain serializable tree so a snapshot is a cheap clone."}], "edges": [{"source": "docs_decisions_0014_undo_is_snapshots_undo_snapshots", "target": "docs_decisions_0015_dock_tree_dock_tree", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/decisions/0014-undo-is-snapshots.md", "source_location": null, "weight": 1.0}], "hyperedges": []}